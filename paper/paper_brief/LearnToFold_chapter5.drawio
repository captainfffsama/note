        <mxCell id="e12" value="" edge="1" parent="1" source="candidates" target="choose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="notes" value="没有 CFG 时 uncond 复制 cond。最终关键点输出仍为 [B,21]；sigmoid 标量仍为 [B]。&lt;br&gt;未来成功不是“30 帧内能否完成”；预测的是整回合结果。网络不输出未来 RGB 或显式物理状态，也没有像素重建解码器。&lt;br&gt;源码：training/config.py:680；pi_modified.py:1200 / 1285 / 1540；shared/eval_wrapper.py:215。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="40" y="1050" width="1520" height="145" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="06 骨干内部接口">
    <mxGraphModel dx="1600" dy="1250" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="骨干内部：为什么 2048 维前缀可以供 1024 维专家读取？" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172b4d;fontSize=28;spacing=12;">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="标准 Gemma-2B / Gemma-300M：18 层，8 个 Q heads，1 个 KV head，head_dim=256。两端的隐藏宽度不同，但注意力 head 接口相同。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172b4d;fontSize=17;spacing=12;">
          <mxGeometry as="geometry" x="30" y="90" width="1540" height="75" />
        </mxCell>
        <mxCell id="prefix" value="前缀层输入 Xp [B,Lp,2048]&lt;br&gt;RMSNorm → 同形&lt;br&gt;Lp=834（训练）或 783（推理）" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="40" y="200" width="440" height="130" />
        </mxCell>
        <mxCell id="pqkv" value="Qp [B,Lp,8,256]&lt;br&gt;Kp、Vp 各 [B,Lp,1,256]&lt;br&gt;RoPE / mask 保持张量轴长度" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="580" y="200" width="440" height="130" />
        </mxCell>
        <mxCell id="pout" value="前缀注意力输出 [B,Lp,2048]&lt;br&gt;残差 + Norm + gated FFN&lt;br&gt;2048 → 16384 → 2048，形状复原" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="1120" y="200" width="440" height="130" />
        </mxCell>
        <mxCell id="e7" value="" edge="1" parent="1" source="prefix" target="pqkv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e8" value="" edge="1" parent="1" source="pqkv" target="pout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="cache" value="每层存 Kp/Vp；堆叠 18 层&lt;br&gt;训练删尾后：[18,B,783,1,256]&lt;br&gt;KVTransform 的层混合矩阵 [18,18]&lt;br&gt;输出同形，不把 2048 直接映射到 1024" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="580" y="420" width="440" height="165" />
        </mxCell>
        <mxCell id="e10" value="" edge="1" parent="1" source="pqkv" target="cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sx" value="专家层输入 Xs [B,31,1024]&lt;br&gt;AdaRMS 条件 c [B,1024]&lt;br&gt;Linear(c)→[B,3072]→scale/shift/gate&lt;br&gt;各 [B,1,1024]，广播到31个token" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172b4d;fontSize=17;spacing=12;">
          <mxGeometry as="geometry" x="40" y="650" width="440" height="165" />
        </mxCell>
        <mxCell id="sqkv" value="Qs [B,31,8,256]&lt;br&gt;Ks、Vs 各 [B,31,1,256]&lt;br&gt;拼上该层 prefix K/V 后：&lt;br&gt;K、V 各 [B,814,1,256]" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="580" y="650" width="440" height="165" />
        </mxCell>
        <mxCell id="attn" value="GQA 注意力（8 Q / 1 KV）&lt;br&gt;分数概念形状 [B,8,31,814]&lt;br&gt;聚合 V → [B,31,8,256]&lt;br&gt;输出投影 → [B,31,1024]" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="1120" y="650" width="440" height="165" />
        </mxCell>
        <mxCell id="e14" value="" edge="1" parent="1" source="sx" target="sqkv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e15" value="" edge="1" parent="1" source="cache" target="sqkv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e16" value="" edge="1" parent="1" source="sqkv" target="attn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="ffn" value="门控残差 + AdaRMS + gated FFN&lt;br&gt;[B,31,1024] → [B,31,4096]&lt;br&gt;→ [B,31,1024] → 门控残差&lt;br&gt;18 层后 final norm；再拆动作与 FM query" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="1120" y="920" width="440" height="170" />
        </mxCell>
        <mxCell id="e18" value="" edge="1" parent="1" source="attn" target="ffn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="source" value="接口依据：仓库固定的 openpi 提交&lt;br&gt;c23745b5ad24e98f66967ea795a07b2588ed6c79&lt;br&gt;src/openpi/models/gemma.py&lt;br&gt;Flash/XSA 实现可能不显式物化完整分数矩阵；这里标逻辑形状。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="40" y="920" width="980" height="170" />
        </mxCell>
      </root>
