          <mxGeometry height="130" width="440" x="1120" y="200" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="ids" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;" target="shift" value="">
