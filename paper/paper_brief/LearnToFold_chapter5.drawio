  <diagram id="p5" name="05 注意力与梯度">
    <mxGraphModel dx="1600" dy="1250" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="注意力、训练监督与推理接口" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172b4d;fontSize=28;spacing=12;">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="本页的虚线只表示监督/梯度关系；其他页实线表示张量流向。当前/FAST/FM 查询是三个独立可学习 token。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172b4d;fontSize=17;spacing=12;">
          <mxGeometry as="geometry" x="30" y="90" width="1540" height="75" />
        </mxCell>
        <mxCell id="attn" value="注意力可见性（行=读取者，列=被读取者）&lt;br&gt;列：图像+当前query | 状态+衣物 | 优势 | FAST | FAST query | 动作+FM query&lt;br&gt;图像+当前query：  是 | 否 | 否 | 否 | 否 | 否&lt;br&gt;状态+衣物：          是 | 是 | 否 | 否 | 否 | 否&lt;br&gt;优势：                   是 | 是 | 是 | 否 | 否 | 否&lt;br&gt;FAST：                  是 | 是 | 是 | 因果 | 否 | 否&lt;br&gt;FAST query：          是 | 是 | 是 | 是 | 是 | 否&lt;br&gt;动作+FM query：     是 | 是 | 是 | 否 | 否 | 双向&lt;br&gt;以上还需叠加有效 token 掩码和按样本的优势遮蔽。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontSize=19;spacing=12;">
          <mxGeometry as="geometry" x="40" y="200" width="1520" height="300" />
        </mxCell>
        <mxCell id="grad" value="梯度：完整仿真配置&lt;br&gt;use_knowledge_insulation=False&lt;br&gt;当前/FAST损失 → 前缀 VLM&lt;br&gt;FM损失 → 专家 → KVTransform → VLM&lt;br&gt;SigLIP 主干冻结；投影头配置可单独训练" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#172b4d;fontSize=17;spacing=12;">
          <mxGeometry as="geometry" x="40" y="550" width="440" height="185" />
        </mxCell>
        <mxCell id="stop" value="只有残差目标基线显式 stop_gradient&lt;br&gt;y − sg(V̂) 不通过目标推动 success_head&lt;br&gt;共享骨干仍会收到其他路径梯度&lt;br&gt;若开启 knowledge_insulation，则另在&lt;br&gt;KVTransform 之前停止专家→VLM梯度" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#172b4d;fontSize=17;spacing=12;">
          <mxGeometry as="geometry" x="580" y="550" width="440" height="185" />
        </mxCell>
        <mxCell id="loss" value="总训练损失&lt;br&gt;动作 MSE + FAST CE + 加权辅助损失&lt;br&gt;各辅助损失先处理标签有效性&lt;br&gt;再做 IS 权重 / 衣物类别平衡等聚合&lt;br&gt;最终组合在 scripts/train.py:400–574" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#172b4d;fontSize=17;spacing=12;">
          <mxGeometry as="geometry" x="1120" y="550" width="440" height="185" />
        </mxCell>
        <mxCell id="prefix" value="推理：B 个不同观测&lt;br&gt;VLM 前缀只跑一次&lt;br&gt;K/V [18,B,783,1,256]&lt;br&gt;当前标量 [B] / 距离 [B,21]" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontSize=18;spacing=12;">
          <mxGeometry as="geometry" x="40" y="820" width="440" height="160" />
        </mxCell>
        <mxCell id="candidates" value="N 候选：沿 batch 轴复制缓存&lt;br&gt;K/V [18,B·N,783,1,256]&lt;br&gt;独立初噪声 [B·N,30,12]&lt;br&gt;循环去噪；3 个 FM 头随迭代更新" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172b4d;fontSize=17;spacing=12;">
          <mxGeometry as="geometry" x="580" y="820" width="440" height="160" />
        </mxCell>
        <mxCell id="choose" value="best-of-N 评分与选择&lt;br&gt;Δcond、Δuncond 各 [B·N]&lt;br&gt;score=(Δcond+Δuncond)/2 → [B,N]&lt;br&gt;每个观测选最高分候选 → [B,30,12]" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#172b4d;fontSize=17;spacing=12;">
          <mxGeometry as="geometry" x="1120" y="820" width="440" height="160" />
        </mxCell>
        <mxCell id="e11" value="" edge="1" parent="1" source="prefix" target="candidates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#526579;fontSize=15;labelBackgroundColor=#ffffff;">
